{% extends "layout.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "partials/inductionMeetingDetailsSummary.njk" import inductionMeetingDetails %}
{% from "partials/prisonCreated/inductionMeetingDetailsSummary.njk" import prisonCreatedInductionMeetingDetails %}
{% from "partials/additionalLicenceConditionsSummary.njk" import additionalLicenceConditions %}
{% from "partials/additionalPssConditionsSummary.njk" import additionalPssConditions %}
{% from "partials/bespokeConditionsSummary.njk" import bespokeConditions %}
{% from "partials/additionalInformationSummary.njk" import additionalInformationSummary %}
{% from "moj/components/banner/macro.njk" import mojBanner %}
{% from "pages/immediateReleaseConditions.njk" import immediateReleaseConditions %}
{% from "pages/licence/partials/hdcCurfewTimes.njk" import hdcCurfewTimes %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "moj/components/alert/macro.njk" import mojAlert %}

{% set updatedFromNoAppointmentRequired = initialAppointmentUpdatedFromNotRequired | length > 0%}
{% set isApprovedOrActive = licence.statusCode in ["APPROVED", "ACTIVE"] %}
{% set isPrintable = isApprovedOrActive %}
{% set printDisabled = updatedFromNoAppointmentRequired %}
{% set showHdcAlert = (licence.kind == "HDC") and (not licence.homeDetentionCurfewActualDate) %}
{% if showHdcAlert %}
        {% set isPrintable = false %}
{% endif %}
{% set actionWord =  "Print" if isPrintable else "View" %}

{% set prisonKinds = ['TIME_SERVED', 'HARD_STOP'] %}

{% set inProgressHardStopOrTimeServedLicence = prisonKinds.includes(licence.kind) and licence.statusCode == 'IN_PROGRESS' %}
{% set pageTitle = applicationName + " - " + "Check licence details" if inProgressHardStopOrTimeServedLicence else (actionWord + " a licence") %}
{% set pageId = "print-view-page" %}
{% set backLinkHref = "/licence/view/cases" %}
{% set calculateReleaseDateUrl = '/licence/view/id/' + licence.id + '/crds-click' %}

{% block content %}
    {% if showHdcAlert %}
        {{ mojAlert({
            variant: "warning",
            dismissible: false,
            classes: "govuk-!-margin-bottom-8",
            html: 'Add a HDCAD in <a href="' + calculateReleaseDateUrl + '" class="govuk-link" target="_blank" rel="noopener noreferrer">Calculate release dates</a> to be able to print this licence and change details of the initial appointment and first night curfew.'
        }) }}
    {% endif %}
    {% if isLicenceUnsubmittable %}
        {{ mojBanner({
            iconFallbackText: 'Warning',
            text: "This licence cannot be printed until a date and time for the initial appointment have been set. Contact the community probation team to confirm these details.",
            type: 'warning'
        }) }}
    {% endif %}
    {% if initialApptUpdatedMessage | length > 0%}
        {{ mojBanner({
            type: 'success',
            html: initialApptUpdatedMessage,
            iconFallbackText: 'Success'
        }) }}
    {% endif %}
    {% if updatedFromNoAppointmentRequired %}
        {{ mojBanner({
            type: 'success',
            html: initialAppointmentUpdatedFromNotRequired,
            iconFallbackText: 'Success'
        }) }}
    {% endif %}
    <form method="POST">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                {% if inProgressHardStopOrTimeServedLicence %}
                  <h1 class="govuk-heading-l">Check licence details</h1>
                {% elseif licence.typeCode === 'AP' %}
                  <h1 class="govuk-heading-l">{{ actionWord }} licence for {{ (licence.forename + ' ' + licence.surname) | convertToTitleCase }}</h1>
                {% else %}
                    <h1 class="govuk-heading-l">{{ actionWord }} licence type {{ licence.typeCode }} for {{ (licence.forename + ' ' + licence.surname) | convertToTitleCase }}</h1>
                {% endif %}
            </div>
        </div>

        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                {% if warningMessage %}
                    {{ govukWarningText({
                    html: warningMessage
                    }) }}
                {% endif %}

                {% if prisonKinds.includes(licence.kind) %}
                    {{ prisonCreatedInductionMeetingDetails(licence, isEditableByPrison, validationErrors, null, isPrisonUser, noAppointmentNeeded) }}
                {% else %}
                    {{ inductionMeetingDetails(licence, isEditableByPrison, [], null, isPrisonUser) }}
                {% endif %}

                {% if licence.kind === 'HDC' or licence.kind === 'HDC_VARIATION' %}
                    <h2 class="govuk-!-margin-bottom-3 govuk-!-margin-top-3 govuk-heading-m">HDC curfew details</h2>
                    {{ hdcCurfewTimes({ licence: licence, hideBadges: true }) }}
                {% endif %}

                {% if prisonKinds.includes(licence.kind) %}
                    <h2 class="govuk-heading-m">Licence conditions</h2>
                    {{ immediateReleaseConditions(licence.typeCode) }}
                {% else %}
                    {% if licence.typeCode === 'AP' or licence.typeCode === 'AP_PSS' %}
                        {{ additionalLicenceConditions(licence, additionalConditions) }}
                        {{ bespokeConditions(licence.id, null, null, null, licence.bespokeConditions) }}
                    {% endif %}
                    {% if licence.typeCode === 'PSS' or licence.typeCode === 'AP_PSS' %}
                        {{ additionalPssConditions(licence) }}
                    {% endif %}
                {% endif %}

                {% if licence.electronicMonitoringProviderStatus !== 'NOT_NEEDED' %}
                    {{ additionalInformationSummary(licence, isEditableByPrison, validationErrors) }}
                {% endif %}

                {% if isPrintable %}
                    <h2 class="govuk-heading-m margin-top-85 govuk-!-margin-bottom-4">View and print licence</h2>
                {% endif %}
                <div class="govuk-button-group govuk-!-margin-top-8">
                    {% if licence.statusCode == 'IN_PROGRESS'
                        and (licence.kind in ['HARD_STOP', 'TIME_SERVED']) %}
                        {{ govukButton({
                            text: "Send for approval",
                            classes: "govuk-button--primary govuk-!-margin-right-1",
                            preventDoubleClick: true,
                            attributes: { 'data-qa': 'approve-standard-licence'}
                        }) }}
                    {% endif %}

                    {% if isPrintable and not updatedFromNoAppointmentRequired %}
                        {% if isLicenceUnsubmittable %}
                            {{ govukButton({
                                text: "View and print licence PDF",
                                classes: "govuk-button--primary govuk-!-margin-right-1",
                                disabled: isLicenceUnsubmittable,
                                attributes: { 'data-qa': 'print-licence' }
                            }) }}
                        {% else %}
                            {{ govukButton({
                                text: "View and print licence PDF",
                                classes: "govuk-button--primary govuk-!-margin-right-1",
                                href: '/licence/view/id/' + licence.id + '/pdf-print',
                                attributes: { 'data-qa': 'print-licence' }
                            }) }}
                        {% endif %}
                    {% elseif isPrintable and updatedFromNoAppointmentRequired %}
                        {{ govukButton({
                            text: "View and print licence PDF",
                            classes: "govuk-button--primary govuk-!-margin-right-1",
                            disabled: isLicenceUnsubmittable
                        }) }}
                    {% endif %}

                    {{ govukButton({
                        text: "Return to case list",
                        classes: "govuk-button--secondary" if isPrintable or inProgressHardStopOrTimeServedLicence,
                        href: '/licence/view/cases',
                        attributes: { 'data-qa': 'return-to-view-list' }
                    }) }}
                </div>
            </div>
        </div>
    </form>
{% endblock %}
