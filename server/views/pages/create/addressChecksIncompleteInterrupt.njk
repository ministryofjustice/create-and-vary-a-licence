{% extends "layout.njk" %}

{% set pageTitle = applicationName + " - This person has opted in to HDC" %}
{% set pageId = "hdc-address-checks-incomplete-interrupt-page" %}
{% set backLinkHref = backLink %}

{% block content %}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
            <div class="moj-interruption-card">
                <div class="moj-interruption-card__content">
                    <h1 class="govuk-heading-l moj-interruption-card__heading">
                        This person has opted in to HDC
                    </h1>
                    <div class="govuk-body-l moj-interruption-card__body">
                        <p>You must complete the address checks in HDC before you can continue with this licence in CVL.</p>
                        <p><a href="{{ hdcUrl }}" class="govuk-link">Check the HDC service</a> for more information about the HDC application.</p>
                        <p class="govuk-!-margin-top-8"><a href="{{ backLink }}" class="govuk-link">Return to case list</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
